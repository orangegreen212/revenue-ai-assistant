OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Free "Read" token from huggingface.co/settings/tokens — used for embeddings
# via the remote HF Inference API (keeps RAM usage low; no local torch needed)
HF_TOKEN=your_huggingface_token_here

# "csv" (default) or "stripe" — picks which DataSource metrics/snapshot_service.py uses
DATA_SOURCE=csv

# Only needed if DATA_SOURCE=stripe — use a sk_test_... key, never a live key
STRIPE_SECRET_KEY=

# Shared secret required by POST /api/live-metrics/refresh (cron calls this)
REFRESH_TOKEN=change_me

# Comma-free single origin of your deployed Next.js app, e.g. https://your-app.vercel.app
# Leave as * only for local dev
FRONTEND_ORIGIN=*
